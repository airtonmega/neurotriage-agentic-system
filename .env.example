# ============================================================================
# NeuroTriage-AI Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================================

# ============================================================================
# GOOGLE CLOUD PLATFORM
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Pub/Sub Configuration
PUBSUB_TOPIC_AUDIO=neurotriage-audio-input
PUBSUB_SUBSCRIPTION_AUDIO=neurotriage-audio-sub
PUBSUB_TOPIC_RESULTS=neurotriage-results

# Vertex AI
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash

# ============================================================================
# DATABRICKS
# ============================================================================
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxx
DATABRICKS_CLUSTER_ID=xxxx-xxxxxx-xxxxxxxx

# Unity Catalog
DATABRICKS_CATALOG=healthcare_prod
DATABRICKS_SCHEMA=triage_v1

# Vector Search
DATABRICKS_VECTOR_SEARCH_ENDPOINT=vector-search-endpoint
DATABRICKS_VECTOR_SEARCH_INDEX=triage_embeddings

# ============================================================================
# MLFLOW
# ============================================================================
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=neurotriage-evaluation
MLFLOW_REGISTRY_URI=databricks-uc

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PII Masking
PII_MASKING_STRATEGY=TOKEN
PII_SALT=change-this-in-production

# Audio Processing - Deepgram Nova-3 Medical
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3-medical
DEEPGRAM_LANGUAGE=pt-BR

# Pinecone - RAG Híbrido (BM25 + Semântico)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_HYBRID=neurotriage-medical-hybrid
PINECONE_NAMESPACE=medical_knowledge
PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_TRACING=true
ENABLE_EVALUATION=true
ENABLE_SHADOW_MODE=false
ENABLE_HUMAN_IN_THE_LOOP=true

# ============================================================================
# THRESHOLDS (Production)
# ============================================================================
THRESHOLD_FAITHFULNESS=0.85
THRESHOLD_CLINICAL_SAFETY=0.95
THRESHOLD_CONFIDENCE_HUMAN_REVIEW=0.7
MAX_ITERATION_COUNT=3
